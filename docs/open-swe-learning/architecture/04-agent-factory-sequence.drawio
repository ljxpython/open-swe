        </mxCell>
        <mxCell id="m7" value="make_model(model_id, effort)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4667;entryX=0;entryY=0.0;" edge="1" parent="1" source="act7" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="ChatModel + timeout + fallback" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.5333;" edge="1" parent="1" source="act3" target="act7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="声明 Slack/Linear/GitHub/HTTP 工具" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6;entryX=0;entryY=0.0;" edge="1" parent="1" source="act7" target="act4">
          <mxGeometry relative="1" as="geometry"/>
