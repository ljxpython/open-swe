<mxfile>
  <diagram id="page" name="审查子系统">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ra-github" value="GitHub PR&#xa;[Software System: Diff / Reviews / Checks]&#xa;审查输入、历史样本和发布目标" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="0" y="160" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ra-main" value="Main Agent&#xa;[Container: agent.server:get_agent]&#xa;可修改代码、提交、推送、开 PR 的编码 Agent" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="300" y="0" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ra-reviewer" value="Reviewer&#xa;[Container: agent.reviewer:get_reviewer_agent]&#xa;只读仓库与 diff，维护单一 evolving findings，最后 publish_review" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="300" y="310" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ra-analyzer" value="Analyzer&#xa;[Container: agent.analyzer:get_analyzer]&#xa;bootstrap 或 continual 模式生成仓库审查风格 prompt" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="300" y="160" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ra-style" value="Review Style Store&#xa;[Container: save_review_style_prompt]&#xa;按仓库保存 style appendix，供 Reviewer 运行时读取" style="shape=cylinder3;size=15;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="610" y="310" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ra-outcomes" value="Finding Outcomes&#xa;[Container: read_finding_outcomes]&#xa;记录 finding 被接受、关闭或忽略的结果，用于 continual 学习" style="shape=cylinder3;size=15;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="610" y="160" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ra-sandbox" value="Review Sandbox&#xa;[Container: allow_replacement=True]&#xa;每次重新 checkout prepare_review_repo，不保存用户未提交工作" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="610" y="470" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="PR comment / CI feedback" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="ra-github" target="ra-main">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="120"/><mxPoint x="160" y="80"/><mxPoint x="160" y="80"/><mxPoint x="160" y="80"/><mxPoint x="290" y="80"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e1" value="opened / ready_for_review / diff" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="ra-github" target="ra-reviewer">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="330"/><mxPoint x="80" y="390"/><mxPoint x="80" y="390"/><mxPoint x="80" y="390"/><mxPoint x="290" y="390"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="历史 PR reviews" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="ra-github" target="ra-analyzer">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="220"/><mxPoint x="290" y="220"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e3" value="commit / push / open PR" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="ra-main" target="ra-github">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="40"/><mxPoint x="80" y="40"/><mxPoint x="80" y="40"/><mxPoint x="80" y="40"/><mxPoint x="80" y="140"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="prepare_review_repo" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="ra-reviewer" target="ra-sandbox">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="480"/><mxPoint x="420" y="530"/><mxPoint x="420" y="530"/><mxPoint x="420" y="530"/><mxPoint x="600" y="530"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e5" value="publish_review findings" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="ra-reviewer" target="ra-github">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="350"/><mxPoint x="160" y="350"/><mxPoint x="160" y="350"/><mxPoint x="160" y="350"/><mxPoint x="160" y="290"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e6" value="save_review_style_prompt" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="ra-analyzer" target="ra-style">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="250"/><mxPoint x="570" y="250"/><mxPoint x="570" y="250"/><mxPoint x="570" y="250"/><mxPoint x="570" y="370"/><mxPoint x="570" y="370"/><mxPoint x="570" y="370"/><mxPoint x="600" y="370"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e7" value="读取 style appendix" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="ra-reviewer" target="ra-style">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="400"/><mxPoint x="600" y="400"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e8" value="finding outcome" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="ra-reviewer" target="ra-outcomes">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="340"/><mxPoint x="590" y="340"/><mxPoint x="590" y="340"/><mxPoint x="590" y="340"/><mxPoint x="590" y="220"/><mxPoint x="590" y="220"/><mxPoint x="590" y="220"/><mxPoint x="600" y="220"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e9" value="continual read outcomes" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="ra-analyzer" target="ra-outcomes">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="190"/><mxPoint x="600" y="190"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
