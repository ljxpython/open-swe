        <mxCell id="act5" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="channel">
          <mxGeometry x="45" y="550" width="10" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="POST webhook&#xa;事件 payload" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1216;entryX=0;entryY=0.0;" edge="1" parent="1" source="source" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
