        <mxCell id="m2" value="verify_github_signature()&#xa;或 Slack/Linear 校验" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0893;entryX=1;entryY=0.1429;" edge="1" parent="1" source="act1" target="act1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="790" y="230"/><mxPoint x="790" y="260"/></Array>
