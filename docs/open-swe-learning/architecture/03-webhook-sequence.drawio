        </mxCell>
        <mxCell id="m3" value="get_thread_id_from_branch()&#xa;或渠道等价函数" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.2143;entryX=1;entryY=0.2679;" edge="1" parent="1" source="act1" target="act1">
          <mxGeometry relative="1" as="geometry">
