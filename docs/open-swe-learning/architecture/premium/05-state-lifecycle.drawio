        <mxCell id="refs" value="Git refs&#10;open-swe/turns/*" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontFamily=Arial;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1640" y="40" width="100" height="880" as="geometry" />
        </mxCell>
        <mxCell id="state" value="sandbox_state.py&#10;SANDBOX_BACKENDS" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontFamily=Arial;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1960" y="40" width="100" height="880" as="geometry" />
        </mxCell>
        <mxCell id="provider" value="Sandbox Provider" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontFamily=Arial;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="2280" y="40" width="100" height="880" as="geometry" />
        </mxCell>
        <mxCell id="act0" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fontFamily=Arial;fontColor=#172B4D;strokeWidth=1.2;fillColor=#F6F9FD;strokeColor=#D7E2F0;" vertex="1" parent="provider">
          <mxGeometry x="45" y="290" width="10" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fontFamily=Arial;fontColor=#172B4D;strokeWidth=1.2;fillColor=#F6F9FD;strokeColor=#D7E2F0;" vertex="1" parent="refs">
          <mxGeometry x="45" y="440" width="10" height="300" as="geometry" />
