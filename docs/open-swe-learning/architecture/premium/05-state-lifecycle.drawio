        <mxCell id="act6" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fontFamily=Arial;fontColor=#172B4D;strokeWidth=1.2;fillColor=#F6F9FD;strokeColor=#D7E2F0;" vertex="1" parent="checkpoint">
          <mxGeometry x="45" y="490" width="10" height="350" as="geometry" />
        </mxCell>
        <mxCell id="act7" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fontFamily=Arial;fontColor=#172B4D;strokeWidth=1.2;fillColor=#F6F9FD;strokeColor=#D7E2F0;" vertex="1" parent="trigger">
          <mxGeometry x="45" y="790" width="10" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m0" value="创建或复用 thread_id" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1023;entryX=0;entryY=0.0;strokeColor=#6B7C93;fontColor=#6B7C93;labelBackgroundColor=#F7F9FC;strokeWidth=1.2;" edge="1" parent="1" source="trigger" target="act2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="读取 sandbox_id / latest_run_id / refs" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0667;entryX=0;entryY=0.0;strokeColor=#6B7C93;fontColor=#6B7C93;labelBackgroundColor=#F7F9FC;strokeWidth=1.2;" edge="1" parent="1" source="act2" target="act3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="run 开始，进入 PrepareAgentRunMiddleware" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1333;entryX=0;entryY=0.0;strokeColor=#6B7C93;fontColor=#6B7C93;labelBackgroundColor=#F7F9FC;strokeWidth=1.2;" edge="1" parent="1" source="act2" target="act4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="ensure_sandbox_for_thread(thread_id)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0769;entryX=0;entryY=0.0;strokeColor=#6B7C93;fontColor=#6B7C93;labelBackgroundColor=#F7F9FC;strokeWidth=1.2;" edge="1" parent="1" source="act4" target="act5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="内存命中则 ping；否则 reconnect/create" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0833;entryX=0;entryY=0.0;strokeColor=#6B7C93;fontColor=#6B7C93;labelBackgroundColor=#F7F9FC;strokeWidth=1.2;" edge="1" parent="1" source="act5" target="act0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="sandbox backend proxy" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0;exitY=1.0;entryX=1;entryY=0.1667;strokeColor=#6B7C93;fontColor=#6B7C93;labelBackgroundColor=#F7F9FC;strokeWidth=1.2;" edge="1" parent="1" source="act0" target="act5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="持久化 sandbox_id" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0;exitY=0.25;entryX=1;entryY=0.3571;strokeColor=#6B7C93;fontColor=#6B7C93;labelBackgroundColor=#F7F9FC;strokeWidth=1.2;" edge="1" parent="1" source="act5" target="act3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="snapshot refs/open-swe/turns/{user_message_id}" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3846;entryX=0;entryY=0.0;strokeColor=#6B7C93;fontColor=#6B7C93;labelBackgroundColor=#F7F9FC;strokeWidth=1.2;" edge="1" parent="1" source="act4" target="act1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="写入 run 起点 checkpoint" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4615;entryX=0;entryY=0.0;strokeColor=#6B7C93;fontColor=#6B7C93;labelBackgroundColor=#F7F9FC;strokeWidth=1.2;" edge="1" parent="1" source="act4" target="act6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="每个 graph step 持续 checkpoint" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=1;exitY=0.6;entryX=0;entryY=0.1429;strokeColor=#6B7C93;fontColor=#6B7C93;labelBackgroundColor=#F7F9FC;strokeWidth=1.2;" edge="1" parent="1" source="act2" target="act6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="更新 latest_run_id / status" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=1;exitY=0.6667;entryX=0;entryY=0.6429;strokeColor=#6B7C93;fontColor=#6B7C93;labelBackgroundColor=#F7F9FC;strokeWidth=1.2;" edge="1" parent="1" source="act2" target="act3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="GET turn-diff(thread_id, message_id)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.7273;entryX=0;entryY=0.7333;strokeColor=#6B7C93;fontColor=#6B7C93;labelBackgroundColor=#F7F9FC;strokeWidth=1.2;" edge="1" parent="1" source="trigger" target="act2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="git diff 起点 ref 与当前 worktree" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.8;entryX=0;entryY=0.8333;strokeColor=#6B7C93;fontColor=#6B7C93;labelBackgroundColor=#F7F9FC;strokeWidth=1.2;" edge="1" parent="1" source="act2" target="act1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m13" value="changed files / diff 结果" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0;exitY=1.0;entryX=0.5;entryY=0.8409;strokeColor=#6B7C93;fontColor=#6B7C93;labelBackgroundColor=#F7F9FC;strokeWidth=1.2;" edge="1" parent="1" source="act1" target="trigger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m14" value="sandbox 不可达则通知并停止替换" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0;exitY=0.9167;entryX=1;entryY=0.0;strokeColor=#6B7C93;fontColor=#6B7C93;labelBackgroundColor=#F7F9FC;strokeWidth=1.2;" edge="1" parent="1" source="act5" target="act7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
