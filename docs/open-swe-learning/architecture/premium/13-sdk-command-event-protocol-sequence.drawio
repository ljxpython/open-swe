          </mxGeometry>
        </mxCell>
        <mxCell id="m19" value="stream.messages / toolCalls / subagents / isLoading" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.7606;" edge="1" parent="1" source="act5" target="ui">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m20" value="POST /threads/:id/messages when stream.isLoading" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.7958;entryX=0;entryY=0.7899;" edge="1" parent="1" source="ui" target="act7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m21" value="owner check + image/model validation" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.8319;entryX=0;entryY=0.0;" edge="1" parent="1" source="act7" target="act8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m22" value="queue_message_for_thread(FIFO)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.25;entryX=0;entryY=0.9038;" edge="1" parent="1" source="act8" target="act6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m23" value="check_message_queue_before_model: consume queued input" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.9014;entryX=0;entryY=0.9519;" edge="1" parent="1" source="agent" target="act6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m24" value="inject as user message before next model call" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.9366;" edge="1" parent="1" source="act6" target="agent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
