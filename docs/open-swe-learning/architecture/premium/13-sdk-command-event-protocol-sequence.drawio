        <mxCell id="act8" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="proxy">
          <mxGeometry x="45" y="1180" width="10" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="stream.submit({ messages: [human] }, { config })" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0634;entryX=0;entryY=0.0;" edge="1" parent="1" source="ui" target="act5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="run.start(command) + assistant_id=agent" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0505;entryX=0;entryY=0.0;" edge="1" parent="1" source="act5" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="POST /dashboard/api/threads/:id/commands" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.061;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act7">
          <mxGeometry relative="1" as="geometry"/>
