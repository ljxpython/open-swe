        <mxCell id="m3" value="session cookie + JSON body" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.042;entryX=0;entryY=0.0;" edge="1" parent="1" source="act7" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="threads.get(id); create/stamp on first run.start" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0746;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="enrich model, effort, repo, github_login, stream modes" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1493;entryX=1;entryY=0.194;" edge="1" parent="1" source="act3" target="act3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1350" y="380"/><mxPoint x="1350" y="410"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="POST /threads/:id/commands (enriched run.start)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.2537;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="success { run_id }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.3902;" edge="1" parent="1" source="act0" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="metadata.latest_run_id = run_id" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=1;exitY=0.403;entryX=0;entryY=0.2115;" edge="1" parent="1" source="act3" target="act6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="openEventStream({ channels: root pump })" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4747;entryX=0;entryY=0.5122;" edge="1" parent="1" source="act5" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="POST /threads/:id/stream/events" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.5732;entryX=0;entryY=0.3529;" edge="1" parent="1" source="act4" target="act7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="readable-thread preflight" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.395;entryX=0;entryY=0.6269;" edge="1" parent="1" source="act7" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m12" value="Accept: text/event-stream; body.channels" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.7015;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act2">
          <mxGeometry relative="1" as="geometry"/>
