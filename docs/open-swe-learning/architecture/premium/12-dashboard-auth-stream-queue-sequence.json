{
  "title": "Dashboard OAuth、SSE 与忙碌线程队列",
  "participants": [
    {"id": "browser", "label": "Browser / Agents UI"},
    {"id": "routes", "label": "FastAPI dashboard routes"},
    {"id": "github", "label": "GitHub OAuth"},
    {"id": "session", "label": "Session cookie / OAuth store"},
    {"id": "api", "label": "thread_api.py"},
    {"id": "lg", "label": "LangGraph SDK / Runtime"},
    {"id": "store", "label": "LangGraph Store"},
    {"id": "agent", "label": "Agent middleware"}
  ],
  "messages": [
    {"from": "browser", "to": "routes", "label": "GET /auth/login?redirect_to=/agents"},
    {"from": "routes", "to": "session", "label": "issue state + nonce cookie"},
    {"from": "routes", "to": "github", "label": "302 authorize(client_id, redirect_uri, state)"},
    {"from": "github", "to": "routes", "label": "GET /auth/callback?code&state", "return": true},
    {"from": "routes", "to": "session", "label": "verify nonce; exchange code; store token"},
    {"from": "routes", "to": "browser", "label": "session JWT cookie + redirect /agents", "return": true},
    {"from": "browser", "to": "routes", "label": "GET /threads/sidebar (cookie)"},
    {"from": "routes", "to": "api", "label": "list_dashboard_threads_sidebar()"},
    {"from": "api", "to": "lg", "label": "threads.search + latest run status"},
    {"from": "lg", "to": "api", "label": "thread summaries / metadata", "return": true},
    {"from": "api", "to": "browser", "label": "active + resolved sidebar items", "return": true},
    {"from": "browser", "to": "routes", "label": "POST /threads/:id/commands run.start"},
    {"from": "routes", "to": "api", "label": "auth + JSON validation + ownership"},
    {"from": "api", "to": "lg", "label": "enrich configurable; forward command"},
    {"from": "lg", "to": "api", "label": "accepted + run_id", "return": true},
    {"from": "api", "to": "lg", "label": "persist latest_run_id/status", "async": true},
    {"from": "browser", "to": "routes", "label": "POST /threads/:id/stream/events"},
    {"from": "routes", "to": "api", "label": "readable preflight"},
    {"from": "api", "to": "lg", "label": "POST stream/events; Accept: text/event-stream"},
    {"from": "lg", "to": "api", "label": "messages/tools/lifecycle SSE bytes", "return": true},
    {"from": "api", "to": "browser", "label": "transparent SSE forwarding", "return": true},
    {"from": "browser", "to": "browser", "label": "StreamProvider hydrates state + updates UI", "activate": false},
    {"from": "browser", "to": "routes", "label": "POST /threads/:id/messages while busy"},
    {"from": "routes", "to": "api", "label": "owner/readability + image limits"},
    {"from": "api", "to": "store", "label": "queue_message_for_thread(FIFO)"},
    {"from": "store", "to": "api", "label": "queued", "return": true},
    {"from": "agent", "to": "store", "label": "before each model call: read + delete queue"},
    {"from": "store", "to": "agent", "label": "pending messages", "return": true},
    {"from": "agent", "to": "agent", "label": "inject human messages before next model call", "activate": false}
  ]
}
