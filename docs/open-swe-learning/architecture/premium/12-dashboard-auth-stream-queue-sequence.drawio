        <mxCell id="m0" value="GET /auth/login?redirect_to=/agents" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0556;entryX=0;entryY=0.0;" edge="1" parent="1" source="browser" target="act1">
