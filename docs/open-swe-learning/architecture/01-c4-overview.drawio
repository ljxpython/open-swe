<mxfile>
  <diagram id="page" name="系统上下文">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ctx-user" value="开发者&#xa;[Person: Browser / Electron]&#xa;通过 Dashboard、Desktop、Slack、Linear 或 GitHub 触发编码任务" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#083F75;strokeColor=#06315C;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="200" height="180" as="geometry"/>
        </mxCell>
        <UserObject label="Open SWE&#xa;[Software System: LangGraph + Deep Agents]&#xa;为每个 thread 创建隔离沙箱，运行编码、审查和分析 Agent" link="data:page/id,page" id="ctx-openswe">
          <mxCell style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#1061B0;strokeColor=#0D5091;" vertex="1" parent="1">
          <mxGeometry x="300" y="220" width="240" height="120" as="geometry"/>
        </mxCell>
        </UserObject>
        <mxCell id="ctx-github" value="GitHub&#xa;[Software System: OAuth / App / Webhooks]&#xa;身份认证、仓库 API、Git 流量和 PR 事件来源" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="0" y="220" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-chat" value="Slack / Linear&#xa;[Software System: Webhooks / Tokens]&#xa;外部消息入口和 Agent 回复出口" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="0" y="370" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-langgraph" value="LangGraph Runtime&#xa;[Software System: LangGraph Server + SDK]&#xa;Thread、Run、Checkpoint、SSE 事件和图执行宿主" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="610" y="140" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-model" value="模型提供商&#xa;[Software System: OpenAI-compatible HTTPS Chat]&#xa;模型调用、推理内容和工具调用决策" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="610" y="290" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-sandbox" value="Sandbox Provider&#xa;[Software System: LangSmith / Modal / Daytona / Local]&#xa;执行 shell、读写文件、Git 操作和测试的隔离工作区" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="610" y="450" width="240" height="120" as="geometry"/>
        </mxCell>
