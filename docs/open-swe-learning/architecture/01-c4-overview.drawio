  <diagram id="page" name="组件视图">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="cmp-ui-stream" value="AgentThreadStreamProvider&#xa;[Component: ui/src/features/agents/lib/AgentThreadStreamProvider.tsx]&#xa;为当前 thread 建立 LangGraph StreamProvider，消费 SSE 事件" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
