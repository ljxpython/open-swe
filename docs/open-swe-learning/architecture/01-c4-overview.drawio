        <mxCell id="cmp-api-webhook" value="Webhook adapters&#xa;[Component: agent.webapp.py + utils/{github,slack,linear}.py]&#xa;验证签名、推导 deterministic thread_id、启动图运行" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="300" y="820" width="240" height="120" as="geometry"/>
        </mxCell>
