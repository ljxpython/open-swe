        </mxCell>
        <mxCell id="cmp-api-routes" value="Dashboard routes&#xa;[Component: agent/dashboard/routes.py]&#xa;认证、线程 API、配置、审查和 stream endpoint" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="300" y="660" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="cmp-api-proxy" value="Thread command proxy&#xa;[Component: agent/dashboard/thread_api.py]&#xa;鉴权、线程创建、run.start 入参重建、LangGraph 转发" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
