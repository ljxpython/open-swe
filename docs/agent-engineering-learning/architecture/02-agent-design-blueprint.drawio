  <diagram id="agent-blueprint" name="Agent Engineering Blueprint">
    <mxGraphModel dx="1420" dy="860" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="面向生产的 Agent 设计蓝图：从需求入口到可恢复的受控执行" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1100" height="40" as="geometry"/></mxCell>
        <mxCell id="3" value="以 Open SWE 的真实装配关系为例：Agent 不是一个 prompt，而是一条有状态、有边界、可观测的执行链路。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#52657D;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="1100" height="30" as="geometry"/></mxCell>

        <mxCell id="10" value="用户与触发" style="swimlane;html=1;startSize=28;fontSize=13;fontStyle=1;fontColor=#1F5D9B;fillColor=#F0F7FF;strokeColor=#75B4EE;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="1120" height="110" as="geometry"/></mxCell>
        <mxCell id="11" value="Dashboard / UI&#xa;创建线程、查看事件" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#75B4EE;fontColor=#1F5D9B;fontSize=13;shadow=1;" vertex="1" parent="10"><mxGeometry x="40" y="40" width="190" height="52" as="geometry"/></mxCell>
        <mxCell id="12" value="GitHub / Slack / Linear&#xa;事件、评论、任务" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#75B4EE;fontColor=#1F5D9B;fontSize=13;shadow=1;" vertex="1" parent="10"><mxGeometry x="310" y="40" width="220" height="52" as="geometry"/></mxCell>
        <mxCell id="13" value="确定性 thread_id&#xa;同一事项回到同一上下文" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#75B4EE;fontColor=#1F5D9B;fontSize=13;shadow=1;" vertex="1" parent="10"><mxGeometry x="610" y="40" width="230" height="52" as="geometry"/></mxCell>

        <mxCell id="20" value="接入与控制" style="swimlane;html=1;startSize=28;fontSize=13;fontStyle=1;fontColor=#18786E;fillColor=#F0FBFA;strokeColor=#57BFB0;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="1120" height="120" as="geometry"/></mxCell>
        <mxCell id="21" value="FastAPI 接入层&#xa;OAuth、会话、CORS、签名校验" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#57BFB0;fontColor=#18786E;fontSize=13;shadow=1;" vertex="1" parent="20"><mxGeometry x="40" y="40" width="250" height="58" as="geometry"/></mxCell>
        <mxCell id="22" value="统一 Dispatch&#xa;sync checkpoint + interrupt + 可恢复事件" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#57BFB0;fontColor=#18786E;fontSize=13;shadow=1;" vertex="1" parent="20"><mxGeometry x="400" y="40" width="270" height="58" as="geometry"/></mxCell>
        <mxCell id="23" value="LangGraph Runtime&#xa;Threads / Runs / Stream" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#57BFB0;fontColor=#18786E;fontSize=13;shadow=1;" vertex="1" parent="20"><mxGeometry x="780" y="40" width="260" height="58" as="geometry"/></mxCell>

        <mxCell id="30" value="Agent 执行" style="swimlane;html=1;startSize=28;fontSize=13;fontStyle=1;fontColor=#6844A5;fillColor=#F6F2FF;strokeColor=#9B7DD7;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="1120" height="190" as="geometry"/></mxCell>
        <mxCell id="31" value="get_agent（工厂）&#xa;agent/server.py&#xa;按线程装配" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9B7DD7;fontColor=#6844A5;fontSize=13;shadow=1;" vertex="1" parent="30"><mxGeometry x="40" y="45" width="190" height="74" as="geometry"/></mxCell>
        <mxCell id="32" value="PrepareAgentRunMiddleware&#xa;身份、Sandbox、动态提示词、回合快照" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9B7DD7;fontColor=#6844A5;fontSize=12;shadow=1;" vertex="1" parent="30"><mxGeometry x="280" y="45" width="270" height="74" as="geometry"/></mxCell>
        <mxCell id="33" value="create_deep_agent&#xa;模型推理 → 工具调用 → 观察结果 → 下一轮" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9B7DD7;fontColor=#6844A5;fontSize=12;shadow=1;" vertex="1" parent="30"><mxGeometry x="610" y="45" width="250" height="74" as="geometry"/></mxCell>
