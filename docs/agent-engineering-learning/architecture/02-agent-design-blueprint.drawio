        <mxCell id="35" value="工具与中间件：输入净化 · 限步 · 错误转 ToolMessage · 超时/回退 · 计划模式 · PR 创建守卫 · 子目录规则" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FDFBFF;strokeColor=#C4B1E9;fontColor=#6844A5;fontSize=12;" vertex="1" parent="30"><mxGeometry x="40" y="135" width="1040" height="34" as="geometry"/></mxCell>

        <mxCell id="40" value="状态与资源" style="swimlane;html=1;startSize=28;fontSize=13;fontStyle=1;fontColor=#2E8050;fillColor=#F2FAF4;strokeColor=#6DBA84;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="1120" height="130" as="geometry"/></mxCell>
        <mxCell id="41" value="Checkpoint / Store&#xa;Run 可中断、可恢复" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6DBA84;fontColor=#2E8050;fontSize=13;shadow=1;" vertex="1" parent="40"><mxGeometry x="40" y="40" width="220" height="58" as="geometry"/></mxCell>
        <mxCell id="42" value="线程元数据&#xa;sandbox_id、模型、来源、回合 refs" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6DBA84;fontColor=#2E8050;fontSize=12;shadow=1;" vertex="1" parent="40"><mxGeometry x="330" y="40" width="250" height="58" as="geometry"/></mxCell>
        <mxCell id="43" value="每线程 Sandbox&#xa;文件、git、测试、命令隔离" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6DBA84;fontColor=#2E8050;fontSize=13;shadow=1;" vertex="1" parent="40"><mxGeometry x="660" y="40" width="230" height="58" as="geometry"/></mxCell>
        <mxCell id="44" value="GitHub Proxy&#xa;令牌不写入 Sandbox；到期刷新" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6DBA84;fontColor=#2E8050;fontSize=12;shadow=1;" vertex="1" parent="40"><mxGeometry x="930" y="40" width="150" height="58" as="geometry"/></mxCell>

        <mxCell id="50" value="运行边界 / 技术栈" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F6F9FD;strokeColor=#D7E2F0;fontColor=#32445F;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1220" y="110" width="300" height="610" as="geometry"/></mxCell>
        <mxCell id="51" value="源码证据&#xa;&#xa;FastAPI：agent/api/app.py&#xa;调度：agent/dispatch.py&#xa;主工厂：agent/server.py:get_agent&#xa;安全：agent/middleware/*&#xa;状态：agent/utils/sandbox_state.py&#xa;图注册：langgraph.json&#xa;&#xa;部署运行时&#xa;&#xa;LangGraph Runtime&#xa;PostgreSQL + Redis（生产）&#xa;Sandbox provider&#xa;GitHub OAuth / App&#xa;LLM provider&#xa;&#xa;关键原则&#xa;&#xa;模型负责决策；系统负责边界。&#xa;状态要落在模型外。&#xa;高风险能力要通过专用工具和守卫。" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#32445F;spacingLeft=18;spacingTop=45;" vertex="1" parent="50"><mxGeometry x="0" y="0" width="300" height="610" as="geometry"/></mxCell>

